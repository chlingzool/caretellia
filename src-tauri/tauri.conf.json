{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "caretellia",
  "version": "1.1.2",
  "identifier": "com.chlingzool.caretellia",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "caretellia",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["clc"],
        "name": "Caretellia Letter",
        "description": "Caretellia letter file",
        "mimeType": "application/vnd.caretellia.clc",
        "role": "Viewer",
        "rank": "Owner",
        "exportedType": {
          "identifier": "com.chlingzool.caretellia.clc",
          "conformsTo": ["public.data"]
        }
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5OTA2RkQ3MjZBRTUyQUUKUldTdVVxNG0xMitRQ2NsSjV1d0psQmxlOGU4U0VQVmdyY3RRbHNLNzM4MzJQUDI2dUdvVHZJRksK",
      "endpoints": [
        "https://github.com/chlingzool/caretellia/releases/latest/download/latest.json"
      ]
    }
  }
}
